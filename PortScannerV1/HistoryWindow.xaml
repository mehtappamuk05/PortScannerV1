<Window x:Class="PortScannerV1.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource HistoryTitle}" Height="500" Width="800"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" MouseDown="Window_MouseDown">

    <Window.Resources>
        <!-- Ana Ekrandaki Tablo ve ScrollBar Stilleri -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E1E28"/>
            <Setter Property="Foreground" Value="#A0A0B0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="#2A2A35"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#2A2A35"/>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#16161E"/>
            <Setter Property="Foreground" Value="#3A3A45"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#3A3A45" CornerRadius="5"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Yuvarlatılmış Ana Çerçeve -->
    <Border Background="#16161E" CornerRadius="15" BorderBrush="#2A2A35" BorderThickness="2">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Üst Çubuk (Title Bar) -->
                <RowDefinition Height="*"/>
                <!-- İçerik -->
            </Grid.RowDefinitions>

            <!-- ================= ÜST ÇUBUK ================= -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="{DynamicResource HistoryTitle}" Foreground="{DynamicResource VurguRengi}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Content="—" Width="35" Height="30" Background="Transparent" Foreground="#A0A0B0" BorderThickness="0" FontSize="14" Click="BtnMinimize_Click"/>
                    <Button Content="🗖" Width="35" Height="30" Background="Transparent" Foreground="#A0A0B0" BorderThickness="0" FontSize="14" Click="BtnMaximize_Click"/>
                    <Button Content="✕" Width="35" Height="30" Background="Transparent" Foreground="#FF1744" BorderThickness="0" FontSize="14" FontWeight="Bold" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>

            <!-- ================= İÇERİK BÖLÜMÜ ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Sol Taraf: Önceki Taramalar Listesi -->
                <Border Grid.Column="0" Background="#1E1E28" CornerRadius="8" Padding="10" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{DynamicResource SavedScans}" Foreground="#00E5FF" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                        <DataGrid x:Name="dgScans" Grid.Row="1" Background="Transparent" Foreground="#E0E0E0" 
                                  BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="None" RowBackground="Transparent"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="DgScans_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="Auto"/>
                                <DataGridTextColumn Header="{DynamicResource ColDate}" Binding="{Binding ScanDate}" Width="*"/>
                                <DataGridTextColumn Header="{DynamicResource ColIP}" Binding="{Binding TargetIP}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Sağ Taraf: Seçilen Taramanın Port Detayları -->
                <Border Grid.Column="1" Background="#1E1E28" CornerRadius="8" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{DynamicResource PortDetails}" Foreground="#00E5FF" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                        <DataGrid x:Name="dgDetails" Grid.Row="1" Background="Transparent" Foreground="#E0E0E0" 
                                  BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="None" RowBackground="Transparent"
                                  AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource ColPort}" Binding="{Binding Port}" Width="*"/>
                                <DataGridTextColumn Header="{DynamicResource ColStatus}" Binding="{Binding Status}" Width="*"/>
                                <DataGridTextColumn Header="{DynamicResource ColService}" Binding="{Binding Service}" Width="*"/>
                                <DataGridTextColumn Header="{DynamicResource ColRisk}" Binding="{Binding Risk}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>