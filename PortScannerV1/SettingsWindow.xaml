<Window x:Class="PortScannerV1.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="460" Width="450"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" MouseDown="Window_MouseDown">

    <Border Background="#16161E" CornerRadius="12" BorderBrush="#2A2A35" BorderThickness="2" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="15" Opacity="0.5" Direction="270" ShadowDepth="5"/>
        </Border.Effect>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="{DynamicResource SettingsTitle}" Foreground="#00E5FF" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Content="✕" Width="30" Height="30" Background="Transparent" Foreground="#FF1744" BorderThickness="0" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" Click="BtnClose_Click" Cursor="Hand"/>
            </Grid>

            <StackPanel Grid.Row="1">

                <TextBlock Text="{DynamicResource SetSpeed}" Foreground="#A0A0B0" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                <Border Background="#1E1E28" CornerRadius="8" Padding="10" Margin="0,0,0,20">
                    <StackPanel>
                        <RadioButton x:Name="rbSlow" Content="{DynamicResource SetSlow}" Foreground="White" Margin="0,5"/>
                        <RadioButton x:Name="rbNormal" Content="{DynamicResource SetNormal}" Foreground="White" Margin="0,5" IsChecked="True"/>
                        <RadioButton x:Name="rbAggressive" Content="{DynamicResource SetAggressive}" Foreground="#FF1744" Margin="0,5"/>
                    </StackPanel>
                </Border>

                <!-- 2. Sürekli İzleme -->
                <TextBlock Text="{DynamicResource SetMonitor}" Foreground="#A0A0B0" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                <Border Background="#1E1E28" CornerRadius="8" Padding="10">
                    <StackPanel>
                        <CheckBox x:Name="chkEnableMonitor" Content="{DynamicResource SetMonitorCheck}" Foreground="White" Margin="0,0,0,15" Click="ChkEnableMonitor_Click"/>

                        <StackPanel x:Name="pnlMonitorSettings" IsEnabled="False">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="{DynamicResource SetTargetIP}" Foreground="#E0E0E0" VerticalAlignment="Center" Width="105"/>
                                <TextBox x:Name="txtMonitorIP" Width="140" Height="25" Background="#16161E" Foreground="White" BorderBrush="#3A3A45" VerticalContentAlignment="Center" Padding="5,0" Text="127.0.0.1"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource SetInterval}" Foreground="#E0E0E0" VerticalAlignment="Center" Width="105"/>
                                <TextBox x:Name="txtInterval" Width="50" Height="25" Background="#16161E" Foreground="White" BorderBrush="#3A3A45" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Text="60" PreviewTextInput="NumberValidationTextBox"/>
                                <TextBlock Text="{DynamicResource SetMinutes}" Foreground="#E0E0E0" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            
            <Button x:Name="btnSave" Grid.Row="2" Content="{DynamicResource SetSaveBtn}" Click="BtnSave_Click" Height="40" Margin="0,20,0,0"
                    Background="#1E1E28" Foreground="#00E5FF" BorderBrush="#3A3A45" BorderThickness="1" FontWeight="Bold" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>